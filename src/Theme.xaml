<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hallow Mixer look: dark purple-black, orange accent. Loaded at runtime (no XAML compiler needed). -->
    <SolidColorBrush x:Key="Bg" Color="#16121C"/>
    <SolidColorBrush x:Key="Panel" Color="#211B2A"/>
    <SolidColorBrush x:Key="PanelHi" Color="#2E2639"/>
    <SolidColorBrush x:Key="Line" Color="#3A3248"/>
    <SolidColorBrush x:Key="Text" Color="#ECE8F4"/>
    <SolidColorBrush x:Key="Muted" Color="#8F88A0"/>

    <Style x:Key="Knob" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <Ellipse x:Name="k" Width="18" Height="18" Fill="#ECE8F4" Stroke="#16121C" StrokeThickness="3"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="k" Property="Fill" Value="#FFFFFF"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="k" Property="Width" Value="20"/><Setter TargetName="k" Property="Height" Value="20"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Bar" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"><Border Background="{TemplateBinding Background}" CornerRadius="3"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Vertical channel fader: coloured below the knob (the slider's Foreground), dark above. -->
    <Style x:Key="VFader" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
        <Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="10"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" Orientation="Vertical">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Bar}" Command="Slider.DecreaseLarge" Width="8" Background="{TemplateBinding Foreground}"/></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Bar}" Command="Slider.IncreaseLarge" Width="8" Background="#3A3248"/></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HFader" TargetType="Slider">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" Orientation="Horizontal">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Bar}" Command="Slider.DecreaseLarge" Height="6" Background="{TemplateBinding Foreground}"/></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Bar}" Command="Slider.IncreaseLarge" Height="6" Background="#3A3248"/></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Game/chat balance: both sides dark, the knob shows where the balance is. -->
    <Style x:Key="Balance" TargetType="Slider" BasedOn="{StaticResource HFader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F07820" Offset="0"/><GradientStop Color="#3A3248" Offset="0.5"/><GradientStop Color="#A98BE0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Rectangle Width="2" Height="14" Fill="#8F88A0" HorizontalAlignment="Center"/>
                        <Track x:Name="PART_Track" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Bar}" Command="Slider.DecreaseLarge" Height="6" Background="Transparent"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Bar}" Command="Slider.IncreaseLarge" Height="6" Background="Transparent"/></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="Background" Value="#2E2639"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3A3248"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Mute button: red while muted. -->
    <Style x:Key="Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Btn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3A3248"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#C8414B"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="#F07820"/>
        <Setter Property="Foreground" Value="#1A0E04"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="8,5"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#3A3248"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="#2E2639" CornerRadius="5" BorderBrush="#3A3248" BorderThickness="1">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M0,0 L4,4 L8,0" Stroke="#8F88A0" StrokeThickness="1.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3A3248"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="9,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#241E2E" BorderBrush="#3A3248" BorderThickness="1" CornerRadius="5"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxWidth="420" MaxHeight="320">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
